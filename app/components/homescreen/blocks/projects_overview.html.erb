<%= widget_wrapper do |container| %>
  <% if projects.empty? %>
    <% container.with_body(classes: "op-widget-box--empty") do %>
      <%= render(Primer::Beta::Blankslate.new(test_selector: "projects-overview-widget-empty")) do |component|
            component.with_visual_icon(icon: :project)
            component.with_heading(tag: :h3).with_content(t("homescreen.dashboard.projects.empty"))
          end %>
    <% end %>
  <% else %>
    <% projects.each do |project| %>
      <% container.with_row do %>
        <div class="op-dashboard-project" data-test-selector="projects-overview-row">
          <%= render(Primer::Beta::Link.new(font_weight: :bold, href: helpers.project_path(project))) { project.name } %>
          <% percent = progress.fetch(project.id, 0) %>
          <progress value="<%= percent %>" max="100" aria-label="<%= t("homescreen.dashboard.projects.progress") %>"><%= percent %>%</progress>
          <span class="op-dashboard-meta"><%= percent %>%</span>
          <% if overdue_counts[project.id].to_i.positive? %>
            <%= render(Primer::Beta::Label.new(scheme: :danger)) { t("homescreen.dashboard.projects.overdue", count: overdue_counts[project.id]) } %>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <% container.with_footer do %>
      <%= render(Primer::Beta::Link.new(href: helpers.projects_path)) { t(:label_project_view_all) } %>
    <% end %>
  <% end %>
<% end %>
