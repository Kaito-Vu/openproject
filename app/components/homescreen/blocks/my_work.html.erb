<%= widget_wrapper do |container| %>
  <% if empty? %>
    <% container.with_body(classes: "op-widget-box--empty") do %>
      <%= render(Primer::Beta::Blankslate.new(test_selector: "my-work-widget-empty")) do |component|
            component.with_visual_icon(icon: :checklist)
            component.with_heading(tag: :h3).with_content(t("homescreen.dashboard.my_work.empty"))
          end %>
    <% end %>
  <% else %>
    <% container.with_body do %>
      <% groups.reject { |group| group[:work_packages].empty? }.each do |group| %>
        <h3 class="op-dashboard-group-title <%= "-danger" if group[:key] == :overdue %>">
          <%= t("homescreen.dashboard.my_work.#{group[:key]}") %>
        </h3>
        <ul class="op-dashboard-list" data-test-selector="my-work-<%= group[:key] %>">
          <% group[:work_packages].each do |work_package| %>
            <li>
              <%= link_to "##{work_package.id} #{work_package.subject}", helpers.work_package_path(work_package) %>
              <span class="op-dashboard-meta">
                <%= work_package.project.name %> · <%= work_package.status.name %> ·
                <%= helpers.format_date(work_package.due_date) %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
    <% container.with_footer do %>
      <%= render(Primer::Beta::Link.new(href: wp_list_path(*my_open_filters))) { t("homescreen.dashboard.my_work.view_all") } %>
    <% end %>
  <% end %>
<% end %>
