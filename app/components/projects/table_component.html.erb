<%= component_wrapper(tag: "turbo-frame") do %>
  <div class="project-list-page--table" data-controller="table-action-menu checkable">
    <% if bulk_delete? %>
      <%= form_with url: bulk_action_projects_path, method: :post, id: "projects-bulk-delete-form",
                    data: { turbo_frame: "_top" }, aria: { live: "polite" } do %>
        <%= render(Primer::Beta::Button.new(type: :submit, name: "bulk_action", value: "unarchive", size: :small, mb: 2,
                                            data: { turbo_submits_with: t("projects.bulk_working") })) { t("projects.unarchive.bulk_button") } %>
        <%= render(Primer::Beta::Button.new(type: :submit, name: "bulk_action", value: "destroy", scheme: :danger, size: :small, mb: 2,
                                            data: { turbo_confirm: t("projects.delete.bulk_confirm"),
                                                    turbo_submits_with: t("projects.bulk_working") })) { t("projects.delete.bulk_button") } %>
      <% end %>
    <% end %>
    <div class="generic-table--flex-container">
      <div class="<%= class_names("generic-table--container", container_class) %>">
        <div class="generic-table--results-container">
          <%= content_tag :table,
                          id: table_id,
                          class: "generic-table",
                          data: { controller: "table-highlighting" } do %>
            <colgroup>
              <% if bulk_delete? %><col data-highlight="false"><% end %>
              <% columns.each do |column| %>
                <% if column.attribute == :hierarchy %>
                  <col data-highlight="false">
                <% else %>
                  <col>
                <% end %>
              <% end %>
              <col>
            </colgroup>
            <thead class="-sticky">
              <tr>
                <% if bulk_delete? %>
                  <th scope="col">
                    <input type="checkbox" aria-label="<%= t(:button_check_all) %>" data-action="change->checkable#toggleAll">
                  </th>
                <% end %>
                <% columns.each do |column| %>
                  <% if column.attribute == :hierarchy %>
                    <th id="project-table--hierarchy-header">
                      <div class="generic-table--sort-header-outer generic-table--sort-header-outer_no-highlighting">
                        <div class="generic-table--sort-header">
                          <%= content_tag :a,
                                          helpers.op_icon("icon-hierarchy"),
                                          href: href_only_when_not_sort_lft,
                                          class: "spot-link #{deactivate_class_on_lft_sort}",
                                          data: { "turbo-stream": true },
                                          title: t(:label_sort_by, value: %("#{t(:label_project_hierarchy)}")) %>
                        </div>
                      </div>
                    </th>
                  <% else %>
                    <% if use_quick_action_table_headers? %>
                      <%= quick_action_table_header column, order_options(column, turbo: true) %>
                    <% else %>
                      <th>
                        <div class="generic-table--sort-header-outer">
                          <div class="generic-table--sort-header">
                          <span>
                            <%= column.caption %>
                          </span>
                          </div>
                        </div>
                      </th>
                    <% end %>
                  <% end %>
                <% end %>
                <th>
                  <div class="generic-table--empty-header">
                  </div>
                </th>
              </tr>
            </thead>
            <tbody>
              <% if rows.empty? %>
                <tr class="generic-table--empty-row">
                  <td colspan="<%= columns.length + 1 + (bulk_delete? ? 1 : 0) %>"><%= empty_row_message %></td>
                </tr>
              <% end %>
              <%= render_collection rows %>
            </tbody>
          <% end %>
          <% if inline_create_link && show_inline_create %>
            <div class="wp-inline-create-button">
              <%= inline_create_link %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <% if paginated? %>
    <%= helpers.pagination_links_full(model, **pagination_options) %>
  <% end %>
<% end %>
